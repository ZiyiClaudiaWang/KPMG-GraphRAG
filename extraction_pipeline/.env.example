# Copy to .env (extraction pipeline), or to .env.internal / .env.canonical (dashboard,
# one per Neo4j instance) and fill in. None of these are committed.

# Steps 2b, 5b and 7 (paid)
OPENAI_API_KEY=

# Step 10 (load)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
AURA_INSTANCEID=
AURA_INSTANCENAME=

# Steps 4b (heading levels) and 6a (Exhibit 21): SEC requires a contact
SEC_USER_AGENT="Name Email"

# duckdb: the fact store (financial_facts_v1). Step 6b reads its XBRL segments from it too;
# PIPELINE_FACT_STORE, if set, overrides it for step 6b only
MSFT_FACT_DB_PATH=
