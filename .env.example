# Copy to .env.internal and fill in. Values never get committed - the .env.*
# rule in .gitignore covers them, and this file is the one exception.
#
# Never paste any part of these values into a transcript, a commit, a PR or a
# Notion page. Ask a co-lead and they will send them out of band.
#
# This describes the `internal` instance: the team's own graph, which is what
# the dashboard reads by default. The `canonical` instance - what Eval and
# Agents are given - keeps its credentials in extraction_pipeline/.env.

NEO4J_URI=
NEO4J_USERNAME=

NEO4J_PASSWORD=

# The instance ID, not "neo4j". Using "neo4j" here authenticates and then finds
# an empty database, which reads as a failed load rather than a wrong setting.
NEO4J_DATABASE=

AURA_INSTANCEID=
AURA_INSTANCENAME=

# The structured arm is one DuckDB file, shared by both instances, and it is not
# in the repo. Ask for a copy or build one with tools/build_fact_store.py.
# The data-API store, not the EDGAR one - EDGAR is deprecated as of 13 Nov.
# Absolute path, no ~.
MSFT_FACT_DB_PATH=
