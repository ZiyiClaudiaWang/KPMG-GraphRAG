{
  "$defs": {
    "ClaimDraft": {
      "additionalProperties": false,
      "properties": {
        "quote": {
          "description": "One complete sentence copied exactly from the supplied block text. Preserve all qualifiers.",
          "title": "Quote",
          "type": "string"
        },
        "block_order": {
          "description": "The source block containing the complete sentence.",
          "title": "Block Order",
          "type": "integer"
        },
        "claim_type": {
          "enum": [
            "stated_fact",
            "forward_looking",
            "hedged_risk"
          ],
          "title": "Claim Type",
          "type": "string"
        },
        "subject_text": {
          "description": "The subject as expressed in the source; do not automatically replace it with Apple.",
          "title": "Subject Text",
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact supporting source text needed to interpret references, or null when unnecessary.",
          "title": "Context"
        },
        "annotation_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Mixed content, ambiguous scope or interpretation limits; null when unnecessary.",
          "title": "Annotation Note"
        }
      },
      "required": [
        "quote",
        "block_order",
        "claim_type",
        "subject_text",
        "context",
        "annotation_note"
      ],
      "title": "ClaimDraft",
      "type": "object"
    },
    "MentionDraft": {
      "additionalProperties": false,
      "properties": {
        "surface_text": {
          "description": "Exact text appearing in the source block.",
          "title": "Surface Text",
          "type": "string"
        },
        "candidate_type": {
          "enum": [
            "Company",
            "Subsidiary",
            "Segment",
            "RiskFactor",
            "Other"
          ],
          "title": "Candidate Type",
          "type": "string"
        },
        "block_order": {
          "description": "The source block number supplied in the input.",
          "title": "Block Order",
          "type": "integer"
        }
      },
      "required": [
        "surface_text",
        "candidate_type",
        "block_order"
      ],
      "title": "MentionDraft",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "mentions": {
      "items": {
        "$ref": "#/$defs/MentionDraft"
      },
      "title": "Mentions",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/ClaimDraft"
      },
      "title": "Claims",
      "type": "array"
    }
  },
  "required": [
    "mentions",
    "claims"
  ],
  "title": "ExtractionBatch",
  "type": "object"
}