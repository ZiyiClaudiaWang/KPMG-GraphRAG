      "section_type": "business",
      "section_path": "Part I Item 1 > General",
      "section_label": "Part I Item 1",
      "category": null,
      "subheading": "General",
      "role": "body",
      "text": "We have succeeded in operating stores in smaller towns by offering, at competitive prices, a broader selection of products than does a typical convenience store.",
