      "section_path": "Part I Item 1 > General",
      "section_label": "Part I Item 1",
      "category": null,
      "subheading": "General",
      "role": "body",
      "text": "Many of the smaller communities in which we operate are often not served by national-chain convenience stores.",
      "char_start": 4089,
      "char_end": 4199,
      "raw_spans": [
        [
          4089,
          4199
