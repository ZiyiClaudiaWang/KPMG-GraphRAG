      "section_path": "Part II Item 7 > Capital Expenditures",
      "section_label": "Part II Item 7",
      "category": null,
      "subheading": "Capital Expenditures",
      "role": "body",
      "text": "We are targeting 2.5% of sales for capital expenditures for fiscal 2027 and have an annual long-term target of 2.0%.",
