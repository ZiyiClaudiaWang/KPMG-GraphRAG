      "section_type": "mda",
      "section_path": "Part II Item 7 > Share Repurchases",
      "section_label": "Part II Item 7",
      "category": null,
      "subheading": "Share Repurchases",
      "role": "body",
      "text": "There is no limitation on the number of shares that can be repurchased in a year and there is no expiration date for the program.",
