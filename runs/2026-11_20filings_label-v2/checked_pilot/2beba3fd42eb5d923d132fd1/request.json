      "section_path": "Part II Item 7 > Dividends",
      "section_label": "Part II Item 7",
      "category": null,
      "subheading": "Dividends",
      "role": "body",
      "text": "Cash dividends have been paid for 304 consecutive quarters, including a yearly increase in dividends for the last 70 years.",
