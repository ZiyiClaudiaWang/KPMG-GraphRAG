      "segmentation_version": "kelly_sentence_v3",
      "unit_id": "f4316884-41f9-53ba-bc6c-ee2072da9575"
    },
    {
      "accession_number": "0000076334-26-000105",
      "ticker": "PH",
      "form": "10-K",
      "section_id": "6f04ec47-dbf3-4cf5-81ed-03ec0fe8c805",
      "section_key": "part-ii-item-7",
      "section_type": "mda",
      "section_path": "Part II Item 7 > Debt",
      "section_label": "Part II Item 7",
      "category": null,
      "subheading": "Debt",
      "role": "body",
      "text": "Subsequent to June 30, 2026, to finance the FGC acquisition, the Company borrowed the full $7.75 billion aggregate amount available under the Credit Facilities.",
      "char_start": 25739,
      "char_end": 25899,
      "raw_spans": [
        [
          25900,
          26060
        ]
      ],
      "paragraph_index": 194,
      "prefilter": null,
      "rule_heading": null,
      "risk_summary": false,
      "processing_set_id": "30b73b43-9aeb-488c-a909-bfa8c8b23c35",
      "source_locator": {
        "xpath": "/html/body/div[313]",
        "source_file": "ph-20260630.htm"
      },
      "segmentation_version": "kelly_sentence_v3",
      "unit_id": "23ba7f79-391b-5a7a-bc86-79f7e43138b3"
