        "referenced_form": "DEF 14A",
        "incorporation_status": "unresolved"
      },
      "segmentation_version": "kelly_sentence_v3",
      "unit_id": "3375c74d-ccbb-5c6d-8d5b-9699137060d7",
      "list_intro_id": "0a29ca8a-1458-5283-9b56-7352171cd4f4"
    },
    {
      "accession_number": "0001628280-26-044354",
      "ticker": "MDT",
      "form": "10-K",
      "section_id": "85b5503a-6b06-42e3-a54a-4a27368bcb48",
      "section_key": "part-i-item-1",
      "section_type": "business",
      "section_path": "Part I Item 1",
      "section_label": "Part I Item 1",
      "category": null,
      "subheading": null,
      "role": "body",
      "text": "Turn data, AI, and automation into action: We are confident in our ability to maximize new technology, AI, and data and analytics to tailor therapies in real-time, facilitating remote monitoring and care delivery that conveniently manages conditions, and creates new standards of care.",
      "char_start": 1827,
      "char_end": 2112,
      "raw_spans": [
        [
          1827,
          2112
        ]
      ],
      "paragraph_index": 5,
      "prefilter": null,
      "rule_heading": null,
      "risk_summary": false,
      "processing_set_id": "3716f46d-b588-4f15-86e0-db8def5871ee",
