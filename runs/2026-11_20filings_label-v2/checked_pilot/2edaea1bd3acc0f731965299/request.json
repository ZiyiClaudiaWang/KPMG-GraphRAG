    },
    {
      "accession_number": "0001628280-26-044354",
      "ticker": "MDT",
      "form": "10-K",
      "section_id": "85b5503a-6b06-42e3-a54a-4a27368bcb48",
      "section_key": "part-i-item-1",
      "section_type": "business",
      "section_path": "Part I Item 1",
      "section_label": "Part I Item 1",
      "category": null,
      "subheading": null,
      "role": "body",
      "text": "From the patient journey, to creating agile partnerships that produce novel solutions, to making it easier for our customers to deploy our therapies — what we do is anchored in deep insight, and creates simpler, superior experiences.",
      "char_start": 1591,
      "char_end": 1824,
      "raw_spans": [
        [
          1591,
          1824
        ]
      ],
      "paragraph_index": 4,
      "prefilter": null,
      "rule_heading": null,
      "risk_summary": false,
      "processing_set_id": "3716f46d-b588-4f15-86e0-db8def5871ee",
      "source_locator": {
