      "form": "10-K",
      "section_id": "85b5503a-6b06-42e3-a54a-4a27368bcb48",
      "section_key": "part-i-item-1",
      "section_type": "business",
      "section_path": "Part I Item 1",
      "section_label": "Part I Item 1",
      "category": null,
      "subheading": null,
      "role": "body",
      "text": "Deliver superior outcomes and better experiences for patients and providers: We listen to our patients and customers to better understand the challenges they face.",
      "char_start": 1427,
      "char_end": 1590,
      "raw_spans": [
        [
          1427,
          1590
        ]
      ],
      "paragraph_index": 4,
      "prefilter": null,
      "rule_heading": null,
      "risk_summary": false,
      "processing_set_id": "3716f46d-b588-4f15-86e0-db8def5871ee",
