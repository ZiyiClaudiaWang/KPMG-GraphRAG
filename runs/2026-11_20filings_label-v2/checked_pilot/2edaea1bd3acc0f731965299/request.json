      "ticker": "MDT",
      "form": "10-K",
      "section_id": "85b5503a-6b06-42e3-a54a-4a27368bcb48",
      "section_key": "part-i-item-1",
      "section_type": "business",
      "section_path": "Part I Item 1",
      "section_label": "Part I Item 1",
      "category": null,
      "subheading": null,
      "role": "body",
      "text": "In May 2025, the Company announced its intent to separate the Diabetes Business, with the intention to create a new independent, publicly traded company, MiniMed Group, Inc. (MiniMed).",
      "char_start": 2345,
      "char_end": 2529,
      "raw_spans": [
