      "list_intro_id": "0a29ca8a-1458-5283-9b56-7352171cd4f4"
    },
    {
      "accession_number": "0001628280-26-044354",
      "ticker": "MDT",
      "form": "10-K",
      "section_id": "85b5503a-6b06-42e3-a54a-4a27368bcb48",
      "section_key": "part-i-item-1",
      "section_type": "business",
      "section_path": "Part I Item 1",
      "section_label": "Part I Item 1",
      "category": null,
      "subheading": null,
      "role": "body",
      "text": "We have three reportable segments that primarily develop, manufacture, distribute, and sell device-based medical therapies and services: the Cardiovascular Portfolio, the Neuroscience Portfolio, and the Medical Surgical Portfolio.",
      "char_start": 2114,
      "char_end": 2344,
      "raw_spans": [
