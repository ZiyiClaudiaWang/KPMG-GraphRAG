    {
      "accession_number": "0000726958-26-000046",
      "ticker": "CASY",
      "form": "10-K",
      "section_id": "547de758-500b-4fe0-b3d9-62f994480b6e",
      "section_key": "part-i-item-1",
      "section_type": "business",
      "section_path": "Part I Item 1 > The Company",
      "section_label": "Part I Item 1",
      "category": null,
      "subheading": "The Company",
      "role": "body",
      "text": "If the store’s layout or location does not allow for a full-service kitchen, the store typically will be operated as “GoodStop (by Casey’s)” or the acquired brand.",
      "char_start": 1842,
      "char_end": 2005,
      "raw_spans": [
