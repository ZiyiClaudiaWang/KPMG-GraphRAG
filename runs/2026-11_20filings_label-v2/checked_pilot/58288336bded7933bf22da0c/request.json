      "ticker": "CASY",
      "form": "10-K",
      "section_id": "547de758-500b-4fe0-b3d9-62f994480b6e",
      "section_key": "part-i-item-1",
      "section_type": "business",
      "section_path": "Part I Item 1 > The Company",
      "section_label": "Part I Item 1",
      "category": null,
      "subheading": "The Company",
      "role": "body",
      "text": "When the Company acquires stores, the locations are typically re-branded as \"Casey’s\" as soon as the store is remodeled to include a full-service kitchen.",
      "char_start": 1687,
      "char_end": 1841,
      "raw_spans": [
        [
          1687,
          1841
        ]
      ],
      "paragraph_index": 5,
      "prefilter": null,
      "rule_heading": null,
      "risk_summary": false,
      "processing_set_id": "dd2aa6d6-8dde-4850-87b4-3c82aa8993b1",
      "source_locator": {
