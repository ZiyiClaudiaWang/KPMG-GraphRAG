      "section_path": "Part I Item 1 > The Company",
      "section_label": "Part I Item 1",
      "category": null,
      "subheading": "The Company",
      "role": "body",
      "text": "However, some of these locations do not have a full-service kitchen and, therefore, have limited prepared food offerings.",
      "char_start": 1565,
      "char_end": 1686,
      "raw_spans": [
        [
          1565,
          1686
        ]
      ],
      "paragraph_index": 5,
