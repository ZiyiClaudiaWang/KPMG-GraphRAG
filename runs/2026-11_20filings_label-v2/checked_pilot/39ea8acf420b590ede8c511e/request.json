      "section_path": "Part I Item 2 > Liquidity",
      "section_label": "Part I Item 2",
      "category": null,
      "subheading": "Liquidity",
      "role": "body",
      "text": "The Credit Facility provides backup funding for the commercial paper programs and may also be used for general corporate purposes.",
      "char_start": 48246,
      "char_end": 48376,
      "raw_spans": [
        [
          48308,
          48438
        ]
