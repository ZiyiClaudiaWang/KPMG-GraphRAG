      "section_key": "part-i-item-2",
      "section_type": "mda",
      "section_path": "Part I Item 2 > Liquidity",
      "section_label": "Part I Item 2",
      "category": null,
      "subheading": "Liquidity",
      "role": "body",
      "text": "The Credit Facility provides us with the ability to increase our borrowing capacity by an additional $1.0 billion at any time during the term of the agreement.",
