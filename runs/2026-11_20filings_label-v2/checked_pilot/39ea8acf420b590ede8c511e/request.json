      "section_path": "Part I Item 2 > Liquidity",
      "section_label": "Part I Item 2",
      "category": null,
      "subheading": "Liquidity",
      "role": "body",
      "text": "At July 31, 2026 and April 24, 2026, no amounts were outstanding under the Credit Facility.",
