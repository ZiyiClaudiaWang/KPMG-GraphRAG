      "unit_id": "3cd8bacd-c94d-59e1-af9d-c9dee0701ca6"
    },
    {
      "accession_number": "0000076334-26-000073",
      "ticker": "PH",
      "form": "10-Q",
      "section_id": "8fc5d3ce-decd-497b-90d6-e2b59b5db2a5",
      "section_key": "part-i-item-2",
      "section_type": "mda",
      "section_path": "Part I Item 2 > Debt",
      "section_label": "Part I Item 2",
      "category": null,
      "subheading": "Debt",
      "role": "body",
      "text": "Taking into account outstanding commercial paper notes, $1.7 billion was available for borrowing under the credit agreement as of March 31, 2026.",
