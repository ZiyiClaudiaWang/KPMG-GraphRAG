        "source_file": "ph-20260331.htm"
      },
      "segmentation_version": "kelly_sentence_v3",
      "unit_id": "167e4cd3-d331-5a26-9d53-a7ebc6b3f0cc"
    },
    {
      "accession_number": "0000076334-26-000073",
      "ticker": "PH",
      "form": "10-Q",
      "section_id": "8fc5d3ce-decd-497b-90d6-e2b59b5db2a5",
      "section_key": "part-i-item-2",
      "section_type": "mda",
      "section_path": "Part I Item 2 > Debt",
      "section_label": "Part I Item 2",
      "category": null,
      "subheading": "Debt",
      "role": "body",
      "text": "As of March 31, 2026, there were no borrowings outstanding under the revolving credit agreement, and commercial paper notes outstanding were $2.1 billion.",
      "char_start": 30641,
      "char_end": 30795,
      "raw_spans": [
        [
          30705,
