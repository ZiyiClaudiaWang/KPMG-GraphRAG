      "section_path": "Part I Item 2 > Cash Flows",
      "section_label": "Part I Item 2",
      "category": null,
      "subheading": "Cash Flows",
      "role": "body",
      "text": "Days supply of inventory on hand was 88 days at March 31, 2026, 82 days at June 30, 2025 and 85 days at March 31, 2025.",
