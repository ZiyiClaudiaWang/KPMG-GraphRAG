  "context_units": [
    {
      "accession_number": "0000320187-26-000193",
      "ticker": "NKE",
      "form": "10-Q",
      "section_id": "9fa9520e-eb59-46d9-93a5-d061b49efdee",
      "section_key": "part-i-item-2",
      "section_type": "mda",
      "section_path": "Part I Item 2 > OPERATIONS",
      "section_label": "Part I Item 2",
      "category": null,
      "subheading": "OPERATIONS",
      "role": "body",
      "text": "The net change in certain working capital components and other assets and liabilities was primarily driven by decreases in Accrued liabilities and Income taxes payable and an increase in Inventories, partially offset by a decrease in Accounts receivable.",
      "char_start": 37586,
      "char_end": 37840,
      "raw_spans": [
        [
          37908,
          38162
        ]
      ],
      "paragraph_index": 346,
      "prefilter": null,
      "rule_heading": null,
      "risk_summary": false,
      "processing_set_id": "53aa8e89-d013-4040-ad3a-4892206b66ec",
      "source_locator": {
        "xpath": "/html/body/div[125]",
        "source_file": "nke-20260831.htm"
      },
      "segmentation_version": "kelly_sentence_v3",
      "unit_id": "291e260a-056f-5e8b-a577-a944db794225"
    },
    {
      "accession_number": "0000320187-26-000193",
      "ticker": "NKE",
      "form": "10-Q",
      "section_id": "9fa9520e-eb59-46d9-93a5-d061b49efdee",
      "section_key": "part-i-item-2",
      "section_type": "mda",
      "section_path": "Part I Item 2 > OPERATIONS",
      "section_label": "Part I Item 2",
      "category": null,
      "subheading": "OPERATIONS",
      "role": "body",
      "text": "The decrease in Accrued liabilities was primarily due to payments related to employee compensation.",
      "char_start": 37841,
      "char_end": 37940,
      "raw_spans": [
        [
          38163,
          38262
        ]
      ],
      "paragraph_index": 346,
      "prefilter": null,
      "rule_heading": null,
      "risk_summary": false,
      "processing_set_id": "53aa8e89-d013-4040-ad3a-4892206b66ec",
      "source_locator": {
        "xpath": "/html/body/div[125]",
        "source_file": "nke-20260831.htm"
      },
      "segmentation_version": "kelly_sentence_v3",
      "unit_id": "9033f151-10b7-56e9-a2fa-68c9ec0140ca"
    },
    {
      "accession_number": "0000320187-26-000193",
      "ticker": "NKE",
      "form": "10-Q",
      "section_id": "9fa9520e-eb59-46d9-93a5-d061b49efdee",
      "section_key": "part-i-item-2",
      "section_type": "mda",
      "section_path": "Part I Item 2 > OPERATIONS",
      "section_label": "Part I Item 2",
      "category": null,
      "subheading": "OPERATIONS",
      "role": "body",
      "text": "The increase in Inventories was primarily due to shifts in product mix.",
      "char_start": 37941,
      "char_end": 38012,
      "raw_spans": [
        [
          38263,
          38334
        ]
      ],
      "paragraph_index": 346,
      "prefilter": null,
      "rule_heading": null,
      "risk_summary": false,
      "processing_set_id": "53aa8e89-d013-4040-ad3a-4892206b66ec",
      "source_locator": {
        "xpath": "/html/body/div[125]",
        "source_file": "nke-20260831.htm"
      },
      "segmentation_version": "kelly_sentence_v3",
      "unit_id": "3005c11f-bf35-59f2-adcc-86245d35b897"
    },
    {
      "accession_number": "0000320187-26-000193",
      "ticker": "NKE",
      "form": "10-Q",
      "section_id": "9fa9520e-eb59-46d9-93a5-d061b49efdee",
      "section_key": "part-i-item-2",
      "section_type": "mda",
      "section_path": "Part I Item 2 > OPERATIONS",
      "section_label": "Part I Item 2",
      "category": null,
      "subheading": "OPERATIONS",
      "role": "body",
      "text": "The decreases in Accounts receivable and Income taxes payable were primarily due to receipt of the International Emergency Economic Powers Act tariff receivable and the related U.S. federal income tax payment.",
      "char_start": 38013,
      "char_end": 38222,
      "raw_spans": [
        [
          38335,
          38544
        ]
