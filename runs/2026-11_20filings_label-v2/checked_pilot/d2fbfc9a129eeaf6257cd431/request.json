      "section_type": "risk_factors",
      "section_path": "Part II Item 1A > GENERAL RISKS",
      "section_label": "Part II Item 1A",
      "category": "GENERAL RISKS",
      "subheading": null,
      "role": "body",
      "text": "Worsening economic conditions, including inflation, recession, pandemic, or other changes in economic conditions, may cause lower IT spending and adversely affect our results of operations.",
      "char_start": 61360,
      "char_end": 61549,
      "raw_spans": [
        [
          61669,
          61858
        ]
      ],
      "paragraph_index": 89,
      "prefilter": null,
      "rule_heading": null,
      "risk_summary": false,
      "processing_set_id": "7f7614ef-8e07-4d49-ba49-404730ef85ff",
      "source_locator": {
