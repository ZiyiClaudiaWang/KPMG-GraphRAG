      "section_type": "risk_factors",
      "section_path": "Part II Item 1A > GENERAL RISKS",
      "section_label": "Part II Item 1A",
      "category": "GENERAL RISKS",
      "subheading": null,
      "role": "body",
      "text": "If demand for computing power, PCs, servers, and other computing devices declines, or consumer or business spending for those products declines, our results of operations could be adversely affected.",
      "char_start": 61550,
      "char_end": 61749,
      "raw_spans": [
        [
          61859,
