      "section_type": "risk_factors",
      "section_path": "Part II Item 1A > GENERAL RISKS",
      "section_label": "Part II Item 1A",
      "category": "GENERAL RISKS",
      "subheading": null,
      "role": "body",
      "text": "Our product distribution system relies on an extensive partner and retail network.",
      "char_start": 61751,
      "char_end": 61833,
      "raw_spans": [
        [
          62060,
          62142
        ]
