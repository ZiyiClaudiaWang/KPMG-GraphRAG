        "xpath": "/html/body/div[384]",
        "source_file": "nke-20260531.htm"
      },
      "segmentation_version": "kelly_sentence_v3",
      "unit_id": "8d940e64-4f2a-5752-b2bf-39d403a0e607"
    },
    {
      "accession_number": "0000320187-26-000088",
      "ticker": "NKE",
      "form": "10-K",
      "section_id": "ad991d0a-b082-4963-9050-b5917cb95d47",
      "section_key": "part-ii-item-7",
      "section_type": "mda",
      "section_path": "Part II Item 7 > TRANSACTIONAL EXPOSURES",
      "section_label": "Part II Item 7",
      "category": null,
      "subheading": "TRANSACTIONAL EXPOSURES",
      "role": "body",
      "text": "Other Costs — Non-functional currency denominated costs, such as endorsement contracts, also generate foreign currency risk, though to a lesser extent.",
      "char_start": 48733,
      "char_end": 48884,
      "raw_spans": [
        [
          49265,
          49416
        ]
      ],
      "paragraph_index": 358,
