      "ticker": "MDT",
      "form": "10-K",
      "section_id": "03f89ee6-0bbc-4432-87d5-8c90176b5c3c",
      "section_key": "part-ii-item-7",
      "section_type": "mda",
      "section_path": "Part II Item 7 > Liquidity",
      "section_label": "Part II Item 7",
      "category": null,
      "subheading": "Liquidity",
      "role": "body",
      "text": "At each anniversary date of the Credit Facility, we can request a one-year extension of the maturity date.",
      "char_start": 51739,
      "char_end": 51845,
      "raw_spans": [
        [
          52088,
