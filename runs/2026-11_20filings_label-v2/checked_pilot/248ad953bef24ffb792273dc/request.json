      "section_path": "Part II Item 7 > Liquidity",
      "section_label": "Part II Item 7",
      "category": null,
      "subheading": "Liquidity",
      "role": "body",
      "text": "The issuance of commercial paper reduces the amount of credit available under our existing line of credit, as explained below.",
      "char_start": 51495,
      "char_end": 51621,
      "raw_spans": [
        [
          51844,
