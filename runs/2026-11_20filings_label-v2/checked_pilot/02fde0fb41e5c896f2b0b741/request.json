      "segmentation_version": "kelly_sentence_v3",
      "unit_id": "ab262799-7729-50a3-9588-0652465f8306"
    },
    {
      "accession_number": "0000076334-26-000105",
      "ticker": "PH",
      "form": "10-K",
      "section_id": "6f04ec47-dbf3-4cf5-81ed-03ec0fe8c805",
      "section_key": "part-ii-item-7",
      "section_type": "mda",
      "section_path": "Part II Item 7 > Debt",
      "section_label": "Part II Item 7",
      "category": null,
      "subheading": "Debt",
      "role": "body",
      "text": "Taking into account outstanding commercial paper notes, $2.7 billion was available for borrowing under the revolving credit agreement as of June 30, 2026.",
      "char_start": 25124,
      "char_end": 25278,
      "raw_spans": [
        [
          25285,
          25439
        ]
      ],
      "paragraph_index": 193,
      "prefilter": null,
      "rule_heading": null,
      "risk_summary": false,
      "processing_set_id": "30b73b43-9aeb-488c-a909-bfa8c8b23c35",
      "source_locator": {
