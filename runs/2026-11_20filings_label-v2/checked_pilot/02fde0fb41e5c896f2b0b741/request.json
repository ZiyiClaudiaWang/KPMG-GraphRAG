        "source_file": "ph-20260630.htm"
      },
      "segmentation_version": "kelly_sentence_v3",
      "unit_id": "fdc419f6-7c75-5a05-99b7-18b13c511012"
    },
    {
      "accession_number": "0000076334-26-000105",
      "ticker": "PH",
      "form": "10-K",
      "section_id": "6f04ec47-dbf3-4cf5-81ed-03ec0fe8c805",
      "section_key": "part-ii-item-7",
      "section_type": "mda",
      "section_path": "Part II Item 7 > Debt",
      "section_label": "Part II Item 7",
      "category": null,
      "subheading": "Debt",
      "role": "body",
      "text": "During 2026, we entered into a 364-Day Term Loan Agreement and a Three-Year Term Loan Agreement, which provide for senior unsecured delayed draw term loan facilities in aggregate principal amounts of $5.25 billion and $2.50 billion, respectively (together, the “Credit Facilities”).",
      "char_start": 25280,
      "char_end": 25562,
      "raw_spans": [
        [
          25441,
          25723
        ]
      ],
      "paragraph_index": 194,
      "prefilter": null,
      "rule_heading": null,
      "risk_summary": false,
      "processing_set_id": "30b73b43-9aeb-488c-a909-bfa8c8b23c35",
      "source_locator": {
        "xpath": "/html/body/div[313]",
        "source_file": "ph-20260630.htm"
      },
      "segmentation_version": "kelly_sentence_v3",
      "unit_id": "f0cd033e-499c-5a7c-bc60-33726074a246"
    },
    {
      "accession_number": "0000076334-26-000105",
      "ticker": "PH",
      "form": "10-K",
      "section_id": "6f04ec47-dbf3-4cf5-81ed-03ec0fe8c805",
      "section_key": "part-ii-item-7",
      "section_type": "mda",
      "section_path": "Part II Item 7 > Debt",
      "section_label": "Part II Item 7",
      "category": null,
      "subheading": "Debt",
      "role": "body",
      "text": "The Credit Facilities mature 364 days and three years, respectively, following August 13, 2026.",
      "char_start": 25563,
      "char_end": 25658,
      "raw_spans": [
        [
          25724,
          25819
        ]
      ],
      "paragraph_index": 194,
      "prefilter": null,
      "rule_heading": null,
      "risk_summary": false,
      "processing_set_id": "30b73b43-9aeb-488c-a909-bfa8c8b23c35",
      "source_locator": {
        "xpath": "/html/body/div[313]",
        "source_file": "ph-20260630.htm"
      },
      "segmentation_version": "kelly_sentence_v3",
      "unit_id": "79cc8b6e-3711-5210-ab67-5a199be9c605"
    },
    {
      "accession_number": "0000076334-26-000105",
      "ticker": "PH",
      "form": "10-K",
      "section_id": "6f04ec47-dbf3-4cf5-81ed-03ec0fe8c805",
      "section_key": "part-ii-item-7",
      "section_type": "mda",
      "section_path": "Part II Item 7 > Debt",
      "section_label": "Part II Item 7",
      "category": null,
      "subheading": "Debt",
      "role": "body",
      "text": "As of June 30, 2026, we had not borrowed any funds under the Credit Facilities.",
      "char_start": 25659,
      "char_end": 25738,
      "raw_spans": [
        [
          25820,
          25899
        ]
      ],
      "paragraph_index": 194,
      "prefilter": null,
      "rule_heading": null,
      "risk_summary": false,
      "processing_set_id": "30b73b43-9aeb-488c-a909-bfa8c8b23c35",
      "source_locator": {
        "xpath": "/html/body/div[313]",
        "source_file": "ph-20260630.htm"
      },
      "segmentation_version": "kelly_sentence_v3",
      "unit_id": "f4316884-41f9-53ba-bc6c-ee2072da9575"
    },
    {
      "accession_number": "0000076334-26-000105",
      "ticker": "PH",
      "form": "10-K",
      "section_id": "6f04ec47-dbf3-4cf5-81ed-03ec0fe8c805",
      "section_key": "part-ii-item-7",
      "section_type": "mda",
      "section_path": "Part II Item 7 > Debt",
      "section_label": "Part II Item 7",
      "category": null,
      "subheading": "Debt",
      "role": "body",
      "text": "Subsequent to June 30, 2026, to finance the FGC acquisition, the Company borrowed the full $7.75 billion aggregate amount available under the Credit Facilities.",
      "char_start": 25739,
      "char_end": 25899,
      "raw_spans": [
        [
          25900,
          26060
        ]
      ],
      "paragraph_index": 194,
      "prefilter": null,
      "rule_heading": null,
      "risk_summary": false,
      "processing_set_id": "30b73b43-9aeb-488c-a909-bfa8c8b23c35",
      "source_locator": {
        "xpath": "/html/body/div[313]",
        "source_file": "ph-20260630.htm"
      },
      "segmentation_version": "kelly_sentence_v3",
      "unit_id": "23ba7f79-391b-5a7a-bc86-79f7e43138b3"
    },
    {
      "accession_number": "0000076334-26-000105",
      "ticker": "PH",
      "form": "10-K",
      "section_id": "6f04ec47-dbf3-4cf5-81ed-03ec0fe8c805",
      "section_key": "part-ii-item-7",
      "section_type": "mda",
      "section_path": "Part II Item 7 > Debt",
      "section_label": "Part II Item 7",
      "category": null,
      "subheading": "Debt",
      "role": "body",
      "text": "The Company intends to repay a portion of these borrowings with cash on hand and refinance the remaining borrowings with long-term debt.",
      "char_start": 25900,
      "char_end": 26036,
      "raw_spans": [
        [
          26061,
          26197
        ]
      ],
