      "text": "As of June 30, 2026, there were no borrowings outstanding under the revolving credit agreement, and commercial paper notes outstanding were $1.0 billion.",
      "char_start": 24970,
      "char_end": 25123,
      "raw_spans": [
        [
          25131,
          25284
        ]
      ],
      "paragraph_index": 193,
      "prefilter": null,
      "rule_heading": null,
      "risk_summary": false,
      "processing_set_id": "30b73b43-9aeb-488c-a909-bfa8c8b23c35",
      "source_locator": {
        "xpath": "/html/body/div[313]",
