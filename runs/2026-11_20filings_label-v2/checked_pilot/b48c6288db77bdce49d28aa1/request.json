      "section_type": "business",
      "section_path": "Part I Item 1 > Rockstar Games.",
      "section_label": "Part I Item 1",
      "category": null,
      "subheading": "Rockstar Games.",
      "role": "body",
      "text": "Red Dead Redemption 2, which has been a critical and commercial success that set numerous entertainment industry records, has sold-in more than 80 million units worldwide.",
      "char_start": 10082,
      "char_end": 10253,
      "raw_spans": [
