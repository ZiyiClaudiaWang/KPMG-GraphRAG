      "section_type": "business",
      "section_path": "Part I Item 1 > Rockstar Games.",
      "section_label": "Part I Item 1",
      "category": null,
      "subheading": "Rockstar Games.",
      "role": "body",
      "text": "Rockstar Games continues to invest in the franchise and announced that Grand Theft Auto VI is planned for release on November 19, 2026, during our fiscal year 2027.",
