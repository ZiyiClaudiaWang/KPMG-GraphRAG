      "section_type": "business",
      "section_path": "Part I Item 1 > Rockstar Games.",
      "section_label": "Part I Item 1",
      "category": null,
      "subheading": "Rockstar Games.",
      "role": "body",
      "text": "Rockstar Games continues to expand on its established series by developing sequels, offering downloadable episodes, and providing additional content.",
      "char_start": 10254,
      "char_end": 10403,
      "raw_spans": [
        [
