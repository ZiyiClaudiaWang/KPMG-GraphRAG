      "section_type": "business",
      "section_path": "Part I Item 1 > Rockstar Games.",
      "section_label": "Part I Item 1",
      "category": null,
      "subheading": "Rockstar Games.",
      "role": "body",
      "text": "The label released its first trailer for the title in December 2023 and the second in May 2025, and will share more details this summer.",
      "char_start": 9945,
      "char_end": 10081,
      "raw_spans": [
