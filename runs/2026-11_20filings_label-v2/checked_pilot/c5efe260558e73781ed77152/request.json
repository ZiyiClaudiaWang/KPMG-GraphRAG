      "section_type": "risk_factors",
      "section_path": "Part II Item 1A > GENERAL RISKS",
      "section_label": "Part II Item 1A",
      "category": "GENERAL RISKS",
      "subheading": null,
      "role": "body",
      "text": "Failure to ensure effective transfer of knowledge and smooth transitions involving key employees could hinder our strategic planning and execution.",
      "char_start": 69890,
      "char_end": 70037,
      "raw_spans": [
        [
          70243,
