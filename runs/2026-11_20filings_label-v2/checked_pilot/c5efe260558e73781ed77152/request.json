      "section_type": "risk_factors",
      "section_path": "Part II Item 1A > GENERAL RISKS",
      "section_label": "Part II Item 1A",
      "category": "GENERAL RISKS",
      "subheading": null,
      "role": "body",
      "text": "In the U.S., there has been a general increase in workers exercising their right to form or join a union.",
      "char_start": 70387,
      "char_end": 70492,
      "raw_spans": [
        [
          70740,
          70845
        ]
      ],
