    },
    {
      "accession_number": "0001193125-26-191507",
      "ticker": "MSFT",
      "form": "10-Q",
      "section_id": "6ab480e9-03d4-466d-8e46-c4d7b732e6fe",
      "section_key": "part-ii-item-1a",
      "section_type": "risk_factors",
      "section_path": "Part II Item 1A > GENERAL RISKS",
      "section_label": "Part II Item 1A",
      "category": "GENERAL RISKS",
      "subheading": null,
      "role": "body",
      "text": "Disruptions of these kinds in developed or emerging markets could negatively impact demand for our products and services, impair our ability to operate in certain regions, or increase operating costs.",
      "char_start": 68354,
      "char_end": 68554,
      "raw_spans": [
