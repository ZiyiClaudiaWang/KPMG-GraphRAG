    },
    {
      "accession_number": "0001193125-26-191507",
      "ticker": "MSFT",
      "form": "10-Q",
      "section_id": "6ab480e9-03d4-466d-8e46-c4d7b732e6fe",
      "section_key": "part-ii-item-1a",
      "section_type": "risk_factors",
      "section_path": "Part II Item 1A > GENERAL RISKS",
      "section_label": "Part II Item 1A",
      "category": "GENERAL RISKS",
      "subheading": null,
      "role": "body",
      "text": "Emerging nationalist and protectionist trends and concerns about human rights, the environment, and political expression in specific countries may significantly alter the trade and commercial environments.",
      "char_start": 67732,
      "char_end": 67937,
      "raw_spans": [
