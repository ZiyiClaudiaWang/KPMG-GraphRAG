        "element_id": "item_1a_risk_factors",
        "source_file": "msft-20260331.htm"
      },
      "segmentation_version": "kelly_sentence_v3",
      "unit_id": "6a21fd84-0a2b-5832-a78e-8796380b3f6b"
    },
    {
      "accession_number": "0001193125-26-191507",
      "ticker": "MSFT",
      "form": "10-Q",
      "section_id": "6ab480e9-03d4-466d-8e46-c4d7b732e6fe",
      "section_key": "part-ii-item-1a",
      "section_type": "risk_factors",
      "section_path": "Part II Item 1A > GENERAL RISKS",
      "section_label": "Part II Item 1A",
      "category": "GENERAL RISKS",
      "subheading": null,
      "role": "body",
      "text": "Changes to trade policy or agreements as a result of populism, protectionism, or economic nationalism may result in higher tariffs, local sourcing initiatives, and non-local sourcing restrictions, disagreements among governments on export controls and sanctions toward third countries, investment restrictions, or other developments that make it more difficult to operate and sell our products in foreign countries.",
      "char_start": 67938,
      "char_end": 68353,
      "raw_spans": [
        [
          68269,
