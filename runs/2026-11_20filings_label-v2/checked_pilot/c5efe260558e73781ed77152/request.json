        ]
      ],
      "paragraph_index": 99,
      "prefilter": null,
      "rule_heading": null,
      "risk_summary": false,
      "processing_set_id": "7f7614ef-8e07-4d49-ba49-404730ef85ff",
      "source_locator": {
