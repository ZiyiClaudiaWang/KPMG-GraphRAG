      "section_label": "Part II Item 1A",
      "category": "GENERAL RISKS",
      "subheading": null,
      "role": "body",
      "text": "Effective succession planning is also important to our long-term success.",
      "char_start": 69816,
      "char_end": 69889,
      "raw_spans": [
        [
          70169,
          70242
        ]
