        ]
      ],
      "paragraph_index": 98,
      "prefilter": null,
      "rule_heading": null,
      "risk_summary": false,
      "processing_set_id": "7f7614ef-8e07-4d49-ba49-404730ef85ff",
      "source_locator": {
        "xpath": "/html/body/div[147]/p[4]",
        "element_id": "item_1a_risk_factors",
        "source_file": "msft-20260331.htm"
