    },
    {
      "accession_number": "0001193125-26-191507",
      "ticker": "MSFT",
      "form": "10-Q",
      "section_id": "6ab480e9-03d4-466d-8e46-c4d7b732e6fe",
      "section_key": "part-ii-item-1a",
      "section_type": "risk_factors",
      "section_path": "Part II Item 1A > GENERAL RISKS",
      "section_label": "Part II Item 1A",
      "category": "GENERAL RISKS",
      "subheading": null,
      "role": "body",
      "text": "How employment-related laws are interpreted and applied to our workforce practices may result in increased operating costs and less flexibility in how we meet our workforce needs.",
      "char_start": 70038,
      "char_end": 70217,
      "raw_spans": [
        [
          70391,
          70570
        ]
      ],
      "paragraph_index": 99,
      "prefilter": null,
      "rule_heading": null,
      "risk_summary": false,
      "processing_set_id": "7f7614ef-8e07-4d49-ba49-404730ef85ff",
      "source_locator": {
