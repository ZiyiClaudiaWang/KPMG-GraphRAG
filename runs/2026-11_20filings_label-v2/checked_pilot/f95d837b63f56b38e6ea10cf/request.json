      "ticker": "TTWO",
      "form": "10-K",
      "section_id": "cb5247b9-18e8-4260-b479-c52bc05b80ed",
      "section_key": "part-ii-item-7",
      "section_type": "mda",
      "section_path": "Part II Item 7 > Financial Condition",
      "section_label": "Part II Item 7",
      "category": null,
      "subheading": "Financial Condition",
      "role": "body",
      "text": "We have trade credit insurance on the majority of our customers to mitigate accounts receivable risk.",
      "char_start": 33130,
      "char_end": 33231,
      "raw_spans": [
        [
          33161,
          33262
        ]
      ],
      "paragraph_index": 141,
