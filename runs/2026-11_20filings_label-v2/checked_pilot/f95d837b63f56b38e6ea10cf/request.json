      "section_path": "Part II Item 7 > Financial Condition",
      "section_label": "Part II Item 7",
      "category": null,
      "subheading": "Financial Condition",
      "role": "body",
      "text": "Our five largest customers accounted for 80.6%, 81.0% and 79.8% of net revenue during the fiscal year ended March 31, 2026, 2025 and 2024, respectively.",
      "char_start": 33383,
      "char_end": 33535,
      "raw_spans": [
