      "section_type": "mda",
      "section_path": "Part II Item 7 > CAPITAL RESOURCES",
      "section_label": "Part II Item 7",
      "category": null,
      "subheading": "CAPITAL RESOURCES",
      "role": "body",
      "text": "In the event we were to have any borrowings outstanding under these facilities, failed to meet any covenant and were unable to obtain a waiver from a majority of the banks in the applicable syndicate, any borrowings would become immediately due and payable.",
      "char_start": 59789,
      "char_end": 60046,
