      "section_path": "Part II Item 7 > CAPITAL RESOURCES",
      "section_label": "Part II Item 7",
      "category": null,
      "subheading": "CAPITAL RESOURCES",
      "role": "body",
      "text": "Liquidity is also provided by our $3 billion commercial paper program.",
      "char_start": 60226,
      "char_end": 60296,
      "raw_spans": [
        [
          60872,
          60942
        ]
