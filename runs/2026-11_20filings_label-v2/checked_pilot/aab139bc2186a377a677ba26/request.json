      "section_path": "Part I Item 1 > Overview.",
      "section_label": "Part I Item 1",
      "category": null,
      "subheading": "Overview.",
      "role": "body",
      "text": "Our strategy is to create hit entertainment experiences, delivered on every platform relevant to our audience through a variety of sound business models.",
      "char_start": 1508,
      "char_end": 1661,
      "raw_spans": [
        [
          1508,
