      "form": "10-K",
      "section_id": "2df06d6c-c575-4d7c-81de-5a72d5c72388",
      "section_key": "part-i-item-1",
      "section_type": "business",
      "section_path": "Part I Item 1 > Overview.",
      "section_label": "Part I Item 1",
      "category": null,
      "subheading": "Overview.",
      "role": "body",
      "text": "Our pillars - creativity, innovation, and efficiency - guide us as we strive to create the highest quality, most captivating experiences for our consumers.",
      "char_start": 1662,
      "char_end": 1817,
      "raw_spans": [
        [
