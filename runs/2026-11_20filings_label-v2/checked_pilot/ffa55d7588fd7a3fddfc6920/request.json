      "section_type": "mda",
      "section_path": "Part I Item 2 > CAPITAL RESOURCES",
      "section_label": "Part I Item 2",
      "category": null,
      "subheading": "CAPITAL RESOURCES",
      "role": "body",
      "text": "While individual securities have varying durations, as of August 31, 2026, the weighted average days to maturity of our cash equivalents and short-term investments portfolio was 105 days.",
      "char_start": 42362,
      "char_end": 42549,
      "raw_spans": [
        [
          42707,
          42894
        ]
      ],
      "paragraph_index": 360,
