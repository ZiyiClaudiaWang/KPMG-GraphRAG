        "source_file": "nke-20260831.htm"
      },
      "segmentation_version": "kelly_sentence_v3",
      "unit_id": "2d0eda89-6a65-57b6-946e-4d35697156ae"
    },
    {
      "accession_number": "0000320187-26-000193",
      "ticker": "NKE",
      "form": "10-Q",
      "section_id": "9fa9520e-eb59-46d9-93a5-d061b49efdee",
      "section_key": "part-i-item-2",
      "section_type": "mda",
      "section_path": "Part I Item 2 > CAPITAL RESOURCES",
      "section_label": "Part I Item 2",
      "category": null,
      "subheading": "CAPITAL RESOURCES",
      "role": "body",
      "text": "As of August 31, 2026, we did not have any off-balance sheet arrangements that have, or are reasonably likely to have, a material effect on our current or future financial condition, results of operations, liquidity, capital expenditures or capital resources.",
