    {
      "accession_number": "0000320187-26-000193",
      "ticker": "NKE",
      "form": "10-Q",
      "section_id": "9fa9520e-eb59-46d9-93a5-d061b49efdee",
      "section_key": "part-i-item-2",
      "section_type": "mda",
      "section_path": "Part I Item 2 > CAPITAL RESOURCES",
      "section_label": "Part I Item 2",
      "category": null,
      "subheading": "CAPITAL RESOURCES",
      "role": "body",
      "text": "Our fixed-income investments are exposed to both credit and interest rate risk.",
      "char_start": 42209,
      "char_end": 42288,
      "raw_spans": [
        [
          42554,
          42633
        ]
      ],
      "paragraph_index": 360,
