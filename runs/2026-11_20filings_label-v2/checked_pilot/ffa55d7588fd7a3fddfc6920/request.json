      "section_type": "mda",
      "section_path": "Part I Item 2 > CAPITAL RESOURCES",
      "section_label": "Part I Item 2",
      "category": null,
      "subheading": "CAPITAL RESOURCES",
      "role": "body",
      "text": "As of August 31, 2026, we had Cash and equivalents and Short-term investments totaling $8.4 billion, primarily consisting of commercial paper, corporate notes, deposits held at major banks, money market funds, U.S. Treasury obligations and other investment grade fixed-income securities.",
      "char_start": 41921,
      "char_end": 42208,
      "raw_spans": [
        [
          42266,
          42553
        ]
      ],
      "paragraph_index": 360,
      "prefilter": null,
